# A link stub for zig, not part of Apple's SDK (#944; docs/ci.md, "macOS and
# Windows builds"). It holds only the install name and versions of a framework
# that the rusty_bacnet extension loads at run time, and exports no symbols:
# the extension's references to it resolve when it loads, from the system's
# framework, through -undefined dynamic_lookup.
--- !tapi-tbd
tbd-version:           4
targets:               [ x86_64-macos, arm64-macos ]
install-name:          '/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation'
current-version:       150
compatibility-version: 150
...
